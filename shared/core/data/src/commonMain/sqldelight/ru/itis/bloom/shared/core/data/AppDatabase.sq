CREATE TABLE IF NOT EXISTS diary_entries (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    entry_date TEXT NOT NULL,
    skin_condition INTEGER NOT NULL,
    hydration_level INTEGER,
    problem_zones TEXT,
    notes TEXT,
    photo_url TEXT,
    sync_status TEXT NOT NULL DEFAULT 'synced',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_diary_date ON diary_entries(entry_date DESC);
CREATE INDEX IF NOT EXISTS idx_diary_sync_status ON diary_entries(sync_status);

-- Получение записей с фильтрацией по дате И userId
getEntriesFiltered:
SELECT * FROM diary_entries
WHERE user_id = :user_id
  AND (:from_date IS NULL OR entry_date >= :from_date)
  AND (:to_date IS NULL OR entry_date <= :to_date)
ORDER BY entry_date DESC
LIMIT :limit OFFSET :offset;

-- Получение записи по ID
getEntryById:
SELECT * FROM diary_entries WHERE id = :id;

-- Вставка или обновление записи
upsertEntry:
INSERT OR REPLACE INTO diary_entries (
    id, user_id, entry_date, skin_condition, hydration_level,
    problem_zones, notes, photo_url, sync_status, created_at, updated_at
) VALUES (
    :id, :user_id, :entry_date, :skin_condition, :hydration_level,
    :problem_zones, :notes, :photo_url, :sync_status, :created_at, :updated_at
);

-- Удаление записи по ID
deleteEntryById:
DELETE FROM diary_entries WHERE id = :id;

-- Обновление статуса синхронизации
updateSyncStatus:
UPDATE diary_entries
SET sync_status = :sync_status, updated_at = :updated_at
WHERE id = :id;

-- Получение записей, ожидающих синхронизации (для конкретного пользователя)
getPendingEntries:
SELECT * FROM diary_entries
WHERE user_id = :user_id AND sync_status = 'pending';

-- Получение всех записей пользователя (для синхронизации)
getAllEntriesByUserId:
SELECT * FROM diary_entries WHERE user_id = :user_id;